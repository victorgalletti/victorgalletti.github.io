---
import { t, homePath, languages, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const other = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
const stack = ['Rust', 'Swift', 'SwiftUI', 'Tauri', 'Next.js', 'Supabase', 'MCP', 'AI agents'];
---

<header class="top wrap">
  <a class="brand" href={homePath(lang)}>Victor<span>.</span></a>
  <a class="lang" href={homePath(other)} hreflang={other} lang={other}>{other.toUpperCase()}</a>
</header>

<main>
  <section class="hero wrap">
    <p class="kicker">{tr('hero.kicker')}</p>
    <h1>{tr('hero.title')}</h1>
    <p class="lead">{tr('hero.lead')}</p>
    <div class="ctas">
      <a class="btn primary" href="#projects">{tr('hero.cta')}</a>
      <a class="btn" href="https://github.com/victorgalletti">GitHub</a>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => stack.map((s) => <span>{s}</span>))}
    </div>
  </div>

  <section id="projects" class="wrap" aria-labelledby="projects-title">
    <h2 id="projects-title" class="section-title">{tr('projects.title')}</h2>
    {
      projects.map((p, i) => (
        <article class:list={['stage', { flip: i % 2 === 1 }]} id={p.slug} style={`--c:${p.color}`}>
          <div class="screen" role="img" aria-label={`${p.name}: ${tr('projects.video')}`}>
            <span>{tr('projects.video')}</span>
          </div>
          <div class="copy">
            <h3>{p.name}</h3>
            <p>{p.summary[lang]}</p>
            <ul class="stack">
              {p.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <p class="links">
              {p.repo && <a href={p.repo}>{tr('project.repo')} →</a>}
              {p.watch && <a href={p.watch}>{tr('project.watch')} →</a>}
              {!p.repo && !p.watch && <span>{tr('project.private')}</span>}
            </p>
          </div>
        </article>
      ))
    }
  </section>
</main>

<footer class="wrap foot">
  <p>{tr('footer.building')}</p>
  <p>
    <a href="mailto:victors.galletti@gmail.com">{tr('footer.contact')}</a> ·
    <a href="https://github.com/victorgalletti">GitHub</a>
  </p>
</footer>

<style>
  .wrap {
    width: min(1120px, 100% - 32px);
    margin-inline: auto;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 22px;
  }
  .brand {
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand span {
    color: var(--brand);
  }
  .lang {
    font: 600 12px/1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--g700);
    text-decoration: none;
    border: 1px solid var(--g500);
    border-radius: 20px;
    padding: 7px 12px;
  }
  .lang:hover {
    color: #fff;
    border-color: var(--g700);
  }

  .hero {
    padding-block: clamp(72px, 14vw, 160px) clamp(56px, 10vw, 112px);
  }
  .kicker {
    font: 500 13px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--g600);
    margin: 0 0 20px;
  }
  h1 {
    font-size: clamp(44px, 8vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 0;
    max-width: 13ch;
    color: #fff;
    text-wrap: balance;
  }
  .lead {
    font-size: clamp(19px, 2.2vw, 23px);
    color: var(--g700);
    max-width: 36ch;
    margin: 28px 0 0;
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .btn {
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid var(--g500);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .btn:hover {
    border-color: var(--g700);
  }
  .btn.primary {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .btn.primary:hover {
    background: var(--text);
  }

  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--g300);
    padding-block: 18px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 48px;
    width: max-content;
    animation: slide 40s linear infinite;
  }
  .track span {
    font: 600 clamp(18px, 2.4vw, 26px) / 1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--g600);
    white-space: nowrap;
  }
  .track span::after {
    content: '·';
    margin-left: 48px;
    color: var(--brand);
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  .section-title {
    font: 500 13px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--g600);
    margin: clamp(64px, 10vw, 120px) 0 28px;
  }

  .stage {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(16px, 3vw, 32px);
    margin-bottom: 24px;
    border: 1px solid var(--g300);
    border-radius: 32px;
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--c) 16%, transparent), transparent 60%),
      var(--g200);
  }
  .stage.flip {
    grid-template-columns: 1fr 1.25fr;
  }
  .stage.flip .screen {
    order: 2;
  }
  .screen {
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--g300));
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--c) 28%, #000) 0%, #0b0b0c 75%);
    display: grid;
    place-items: center;
  }
  .screen span {
    font: 500 12px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c) 70%, #fff);
    border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    background: color-mix(in srgb, var(--c) 12%, #000);
    padding: 8px 14px;
    border-radius: 20px;
  }
  .copy h3 {
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 14px;
    color: #fff;
  }
  .copy > p {
    color: var(--g700);
    margin: 0;
    text-wrap: pretty;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stack li {
    font: 500 12px/1 var(--mono);
    padding: 7px 11px;
    border-radius: 20px;
    border: 1px solid var(--g400);
    color: var(--g700);
  }
  .links {
    margin-top: 22px !important;
    display: flex;
    gap: 20px;
    font-weight: 600;
  }
  .links a {
    text-decoration: none;
    color: color-mix(in srgb, var(--c) 75%, #fff);
  }
  .links a:hover {
    text-decoration: underline;
  }
  .links span {
    color: var(--g600);
    font-weight: 500;
  }

  .foot {
    border-top: 1px solid var(--g300);
    margin-top: 96px;
    padding-block: 32px 48px;
    color: var(--g600);
    font-size: 15px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .foot p {
    margin: 0;
  }
  .foot a {
    color: var(--g700);
  }

  @media (max-width: 760px) {
    .stage,
    .stage.flip {
      grid-template-columns: 1fr;
      border-radius: 24px;
    }
    .stage.flip .screen {
      order: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
