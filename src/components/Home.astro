---
import { t, homePath, languages, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const other = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
const stack = ['Rust', 'Swift', 'SwiftUI', 'Tauri', 'Next.js', 'Supabase', 'MCP', 'AI agents'];
---

<header class="top wrap">
  <a class="brand" href={homePath(lang)}>Victor<span>.</span></a>
  <a class="lang" href={homePath(other)} hreflang={other} lang={other}>{other.toUpperCase()}</a>
</header>

<main>
  <section class="hero wrap">
    <p class="kicker">{tr('hero.kicker')}</p>
    <h1>{tr('hero.title')}</h1>
    <p class="lead">{tr('hero.lead')}</p>
    <div class="ctas">
      <a class="btn primary" href="#projects">{tr('hero.cta')}</a>
      <a class="btn" href="https://github.com/victorgalletti">GitHub</a>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => stack.map((s) => <span>{s}</span>))}
    </div>
  </div>

  <section id="projects" class="projects" aria-labelledby="projects-title">
    <div class="wrap head">
      <h2 id="projects-title" class="section-title">{tr('projects.title')}</h2>
      <div class="nav">
        <button type="button" class="arrow" data-dir="-1" aria-label={tr('carousel.prev')}>←</button>
        <button type="button" class="arrow" data-dir="1" aria-label={tr('carousel.next')}>→</button>
      </div>
    </div>
    <ul class="track-x" role="list" tabindex="0" aria-label={tr('projects.title')}>
      {
        projects.map((p, i) => (
          <li class="card" id={p.slug} style={`--c:${p.color}`}>
            <article aria-labelledby={`${p.slug}-name`}>
              <div class="screen" role="img" aria-label={`${p.name}: ${tr('projects.video')}`}>
                <span>{tr('projects.video')}</span>
              </div>
              <div class="copy">
                <p class="count">
                  {String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}
                </p>
                <h3 id={`${p.slug}-name`}>{p.name}</h3>
                <p>{p.summary[lang]}</p>
                <ul class="stack">
                  {p.stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
                <p class="links">
                  {p.repo ? <a href={p.repo}>{tr('project.repo')} →</a> : <span>{tr('project.private')}</span>}
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</main>

<footer class="wrap foot">
  <p>{tr('footer.building')}</p>
  <p>
    <a href="mailto:victors.galletti@gmail.com">{tr('footer.contact')}</a> ·
    <a href="https://github.com/victorgalletti">GitHub</a>
  </p>
</footer>

<style>
  .wrap {
    width: min(1120px, 100% - 32px);
    margin-inline: auto;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 22px;
  }
  .brand {
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand span {
    color: var(--brand);
  }
  .lang {
    font: 600 12px/1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--g700);
    text-decoration: none;
    border: 1px solid var(--g500);
    border-radius: 20px;
    padding: 7px 12px;
  }
  .lang:hover {
    color: #fff;
    border-color: var(--g700);
  }

  .hero {
    padding-block: clamp(72px, 14vw, 160px) clamp(56px, 10vw, 112px);
  }
  .kicker {
    font: 500 13px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--g600);
    margin: 0 0 20px;
  }
  h1 {
    font-size: clamp(44px, 8vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 0;
    max-width: 13ch;
    color: #fff;
    text-wrap: balance;
  }
  .lead {
    font-size: clamp(19px, 2.2vw, 23px);
    color: var(--g700);
    max-width: 36ch;
    margin: 28px 0 0;
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .btn {
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid var(--g500);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .btn:hover {
    border-color: var(--g700);
  }
  .btn.primary {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .btn.primary:hover {
    background: var(--text);
  }

  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--g300);
    padding-block: 18px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 48px;
    width: max-content;
    animation: slide 40s linear infinite;
  }
  .track span {
    font: 600 clamp(18px, 2.4vw, 26px) / 1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--g600);
    white-space: nowrap;
  }
  .track span::after {
    content: '·';
    margin-left: 48px;
    color: var(--brand);
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  .section-title {
    font: 500 13px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--g600);
    margin: clamp(64px, 10vw, 120px) 0 28px;
  }

  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin: clamp(64px, 10vw, 120px) auto 24px;
  }
  .head .section-title {
    margin: 0;
  }
  .nav {
    display: flex;
    gap: 8px;
  }
  .arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--g500);
    background: var(--g200);
    color: var(--text);
    font-size: 18px;
    cursor: pointer;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  .arrow:hover:not(:disabled) {
    border-color: var(--g700);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .track-x {
    --edge: max(16px, (100% - 1120px) / 2);
    list-style: none;
    margin: 0;
    padding: 0 var(--edge) 8px;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track-x::-webkit-scrollbar {
    display: none;
  }
  .card {
    flex: 0 0 min(860px, 100% - 48px);
    scroll-snap-align: start;
  }
  .card article {
    height: 100%;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    padding: clamp(14px, 2.4vw, 24px);
    border: 1px solid var(--g300);
    border-radius: 32px;
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--c) 16%, transparent), transparent 60%),
      var(--g200);
  }
  .screen {
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, var(--g300));
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 28%, #000) 0%, #0b0b0c 75%);
    display: grid;
    place-items: center;
  }
  .screen span {
    font: 500 12px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--c) 70%, #fff);
    border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    background: color-mix(in srgb, var(--c) 12%, #000);
    padding: 8px 14px;
    border-radius: 20px;
  }
  .count {
    font: 500 12px/1 var(--mono) !important;
    letter-spacing: 0.1em;
    color: var(--g600) !important;
    margin: 0 0 14px !important;
  }
  .copy h3 {
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 12px;
    color: #fff;
  }
  .copy > p {
    color: var(--g700);
    margin: 0;
    font-size: 16px;
    text-wrap: pretty;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stack li {
    font: 500 12px/1 var(--mono);
    padding: 7px 11px;
    border-radius: 20px;
    border: 1px solid var(--g400);
    color: var(--g700);
  }
  .links {
    margin-top: 20px !important;
    font-weight: 600;
  }
  .links a {
    text-decoration: none;
    color: color-mix(in srgb, var(--c) 75%, #fff);
  }
  .links a:hover {
    text-decoration: underline;
  }
  .links span {
    color: var(--g600);
    font-weight: 500;
  }

  .foot {
    border-top: 1px solid var(--g300);
    margin-top: 96px;
    padding-block: 32px 48px;
    color: var(--g600);
    font-size: 15px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .foot p {
    margin: 0;
  }
  .foot a {
    color: var(--g700);
  }

  @media (max-width: 760px) {
    .card {
      flex-basis: calc(100% - 32px);
    }
    .card article {
      grid-template-columns: 1fr;
      border-radius: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .track-x {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('.projects')) {
    const track = section.querySelector<HTMLElement>('.track-x')!;
    const arrows = [...section.querySelectorAll<HTMLButtonElement>('.arrow')];
    const step = () => (track.querySelector<HTMLElement>('.card')?.offsetWidth ?? 0) + 20;
    const update = () => {
      arrows[0].disabled = track.scrollLeft <= 4;
      arrows[1].disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    for (const a of arrows) {
      a.addEventListener('click', () => track.scrollBy({ left: Number(a.dataset.dir) * step() }));
    }
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        track.scrollBy({ left: (e.key === 'ArrowRight' ? 1 : -1) * step() });
      }
    });
    track.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
